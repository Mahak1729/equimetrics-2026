# Anthropic API key used by the HorseLLM chat function (netlify/functions/chat.mjs).
# Create one at https://console.anthropic.com/settings/keys
# Locally this is read by the Vite dev server; on Netlify set it under
# Site configuration -> Environment variables (scope: Functions).
ANTHROPIC_API_KEY=sk-ant-...

# Mapbox public token used by the journey map on the client.
# Create one at https://account.mapbox.com/access-tokens/
# On Netlify this must be scoped to Builds, since Vite compiles it into the bundle.
VITE_MAPBOX_TOKEN=pk....

# Optional. Comma-separated list of extra origins allowed to call /api/chat,
# in addition to localhost, *.netlify.app and the production domain.
# ALLOWED_ORIGINS=https://staging.example.com,https://preview.example.com
